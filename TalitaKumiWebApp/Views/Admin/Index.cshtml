@model TalitaKumiWebApp.ViewModels.Admin.AdminDashboardViewModel
@{
    ViewData["Title"] = "Panel de Control";
    Layout = "_AdminLayout";

    var diasSemana = new[]
    {
        ("Lunes", Model.InicioSemana),
        ("Martes", Model.InicioSemana.AddDays(1)),
        ("Miércoles", Model.InicioSemana.AddDays(2)),
        ("Jueves", Model.InicioSemana.AddDays(3)),
        ("Viernes", Model.InicioSemana.AddDays(4)),
        ("Sábado", Model.InicioSemana.AddDays(5))
    };

    var turnos = new[]
    {
        ("Mañana", "10:00 - 13:00"),
        ("Tarde 1", "13:00 - 16:30"),
        ("Tarde 2", "16:30 - 19:30")
    };

    var totalSemana = Model.ReservasSemana.Count;
    var confirmadasSemana = Model.ReservasSemana.Count(r => r.Estado == "Confirmada");
    var pendientesSemana = Model.ReservasSemana.Count(r => r.Estado == "Pendiente");
    var completadasSemana = Model.ReservasSemana.Count(r => r.Estado == "Completada");
}

<div class="container-fluid px-3 px-lg-4">

    <!-- MENSAJES Y NOTIFICACIONES -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div>@TempData["Mensaje"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div>@TempData["Error"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- TOAST ASÍNCRONO FLOTANTE -->
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
        <div id="toastAdmin" class="toast align-items-center text-white bg-dark border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body d-flex align-items-center gap-2" id="toastAdminBody">
                    <i class="bi bi-info-circle-fill"></i>
                    <span>Operación realizada</span>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <!-- CABECERA DE AGENDA Y SELECTOR DE SEMANA -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-body p-3 p-md-4">
            <div class="row align-items-center g-3">
                <div class="col-xl-6 col-lg-5">
                    <span class="text-muted small text-uppercase fw-semibold tracking-wider d-block mb-1">
                        <i class="bi bi-calendar-week me-1 text-primary"></i> Agenda Semanal de Naomi
                    </span>
                    <h2 class="h4 mb-0 fw-bold text-dark font-garamond">
                        Semana del @Model.InicioSemana.ToString("dd 'de' MMMM") al @Model.FinSemana.ToString("dd 'de' MMMM, yyyy")
                    </h2>
                </div>

                <div class="col-xl-6 col-lg-7 d-flex flex-wrap align-items-center justify-content-lg-end gap-2">
                    <div class="btn-group shadow-sm">
                        <a href="/Admin?fecha=@Model.InicioSemana.AddDays(-7).ToString("yyyy-MM-dd")" class="btn btn-outline-secondary btn-sm" title="Semana anterior">
                            <i class="bi bi-chevron-left"></i> Anterior
                        </a>
                        <a href="/Admin" class="btn btn-outline-primary btn-sm fw-semibold" title="Volver a la semana actual">
                            Hoy
                        </a>
                        <a href="/Admin?fecha=@Model.InicioSemana.AddDays(7).ToString("yyyy-MM-dd")" class="btn btn-outline-secondary btn-sm" title="Semana siguiente">
                            Siguiente <i class="bi bi-chevron-right"></i>
                        </a>
                    </div>

                    <div class="d-flex align-items-center gap-2 ms-xl-2">
                        <span class="badge bg-light text-dark border px-2 py-2">
                            Total: <strong>@totalSemana</strong>
                        </span>
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-2">
                            🟢 Confirmadas: <strong>@confirmadasSemana</strong>
                        </span>
                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-2">
                            🟡 Pendientes: <strong>@pendientesSemana</strong>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SECCIÓN SUPERIOR: GRID SEMANAL DE 6 COLUMNAS (LUN-SÁB) Y 3 TURNOS -->
    <div class="card border-0 shadow-sm rounded-4 mb-5 bg-white">
        <div class="card-header bg-white border-bottom border-light-subtle py-3 px-4 d-flex align-items-center justify-content-between">
            <h5 class="mb-0 fw-bold fs-6 text-dark d-flex align-items-center gap-2">
                <i class="bi bi-grid-3x3-gap text-danger"></i> Turnos de Atención (1 cliente por turno)
            </h5>
            <span class="text-muted small">Haz clic en una cita para ver los detalles y WhatsApp</span>
        </div>
        <div class="card-body p-2 p-md-3">
            <div class="table-responsive">
                <table class="table table-bordered mb-0 align-middle calendar-grid-table">
                    <thead class="table-light text-center">
                        <tr>
                            <th style="width: 130px;" class="fw-semibold text-muted small py-3">Turno / Horario</th>
                            @foreach (var (diaNombre, diaFecha) in diasSemana)
                            {
                                var esHoy = diaFecha == DateOnly.FromDateTime(DateTime.Today);
                                <th class="py-2 @(esHoy ? "bg-warning-subtle border-warning" : "")">
                                    <div class="fw-bold @(esHoy ? "text-danger" : "text-dark")">@diaNombre</div>
                                    <div class="text-muted small">@diaFecha.ToString("dd MMM")</div>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (turnoClave, turnHorario) in turnos)
                        {
                            <tr>
                                <td class="bg-light fw-semibold text-center text-secondary small py-3">
                                    <div class="text-dark fw-bold">@turnoClave</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">@turnHorario</div>
                                </td>

                                @foreach (var (diaNombre, diaFecha) in diasSemana)
                                {
                                    var citasTurno = Model.ReservasSemana
                                        .Where(r => r.Fecha == diaFecha && (r.Horario != null && r.Horario.Contains(turnoClave)))
                                        .ToList();

                                    <td class="p-2 align-top calendar-slot-cell" style="min-width: 170px; height: 115px;">
                                        @if (citasTurno.Any())
                                        {
                                            @foreach (var c in citasTurno)
                                            {
                                                var badgeColor = c.Estado switch
                                                {
                                                    "Confirmada" => "border-success bg-success-subtle text-success-emphasis",
                                                    "Completada" => "border-primary bg-primary-subtle text-primary-emphasis",
                                                    "Cancelada" => "border-danger bg-danger-subtle text-danger-emphasis",
                                                    _ => "border-warning bg-warning-subtle text-warning-emphasis"
                                                };

                                                var estadoIcon = c.Estado switch
                                                {
                                                    "Confirmada" => "🟢 Confirmada",
                                                    "Completada" => "🔵 Finalizada",
                                                    "Cancelada" => "🔴 Cancelada",
                                                    _ => "🟡 Pendiente"
                                                };

                                                <div class="appointment-card border rounded-3 p-2 shadow-sm mb-1 bg-white cursor-pointer"
                                                     role="button"
                                                     tabindex="0"
                                                     data-bs-toggle="modal"
                                                     data-bs-target="#modalDetalleCita"
                                                     data-id="@c.Id"
                                                     data-nombre="@c.Nombre"
                                                     data-telefono="@c.Telefono"
                                                     data-servicio="@c.Servicio"
                                                     data-precio="@c.PrecioEstimado"
                                                     data-abono="@c.MontoAbonado"
                                                     data-fecha="@c.Fecha.ToString("dd/MM/yyyy")"
                                                     data-horario="@c.Horario"
                                                     data-estado="@c.Estado"
                                                     data-notas="@(c.Notas ?? "")">
                                                    
                                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                                        <span class="badge border @badgeColor" style="font-size: 0.68rem;">
                                                            @estadoIcon
                                                        </span>
                                                        @if (!string.IsNullOrWhiteSpace(c.Notas))
                                                        {
                                                            <span title="Tiene notas u observaciones" class="text-danger small">
                                                                <i class="bi bi-sticky-fill"></i>
                                                            </span>
                                                        }
                                                    </div>

                                                    <div class="fw-bold text-truncate text-dark small" title="@c.Nombre">
                                                        @c.Nombre
                                                    </div>
                                                    <div class="text-muted text-truncate" style="font-size: 0.75rem;" title="@c.Servicio">
                                                        @c.Servicio
                                                    </div>
                                                    <div class="d-flex justify-content-between align-items-center mt-1" style="font-size: 0.75rem;">
                                                        <span class="fw-semibold text-secondary">S/. @c.PrecioEstimado.ToString("0.00")</span>
                                                        @if (c.MontoAbonado > 0)
                                                        {
                                                            <span class="text-success fw-bold" title="Abonó">✓ S/. @c.MontoAbonado.ToString("0.00")</span>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="slot-empty d-flex align-items-center justify-content-center h-100 rounded-2 text-muted"
                                                 role="button"
                                                 title="Espacio libre. Clic para agendar cita en este turno"
                                                 onclick="prellenarCitaManual('@diaFecha.ToString("yyyy-MM-dd")', '@turnoClave')">
                                                <span class="small text-black-50 d-inline-flex align-items-center gap-1">
                                                    <i class="bi bi-plus-lg"></i> Libre
                                                </span>
                                            </div>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- SECCIÓN INFERIOR: TABLA OPERATIVA DE TODAS LAS RESERVAS -->
    <div class="card border-0 shadow-sm rounded-4 bg-white mb-5">
        <div class="card-header bg-white border-bottom border-light-subtle py-3 px-4">
            <div class="row align-items-center g-3">
                <div class="col-md-5">
                    <h5 class="mb-0 fw-bold fs-6 text-dark d-flex align-items-center gap-2">
                        <i class="bi bi-table text-primary"></i> Gestión de Citas y Reservas
                    </h5>
                    <span class="text-muted small">Edita notas y actualiza estados directamente en cada fila sin ventanas emergentes</span>
                </div>
                
                <!-- BARRA DE FILTROS -->
                <div class="col-md-7">
                    <form method="get" action="/Admin" class="row g-2 justify-content-md-end">
                        <div class="col-auto">
                            <input type="date" name="fecha" value="@(Model.FechaSeleccionada != DateOnly.FromDateTime(DateTime.Today) ? Model.FechaSeleccionada.ToString("yyyy-MM-dd") : "")" class="form-control form-control-sm" title="Filtrar por fecha específica" />
                        </div>
                        <div class="col-auto">
                            <input type="text" name="busqueda" value="@Model.FiltroBusqueda" placeholder="Buscar clienta o teléfono..." class="form-control form-control-sm" style="min-width: 180px;" />
                        </div>
                        <div class="col-auto">
                            <select name="estado" class="form-select form-select-sm">
                                <option value="">Todos los estados</option>
                                <option value="Pendiente" selected="@(Model.FiltroEstado == "Pendiente")">🟡 Pendiente de Abono</option>
                                <option value="Confirmada" selected="@(Model.FiltroEstado == "Confirmada")">🟢 Reserva Confirmada</option>
                                <option value="Completada" selected="@(Model.FiltroEstado == "Completada")">🔵 Servicio Finalizado</option>
                                <option value="Cancelada" selected="@(Model.FiltroEstado == "Cancelada")">🔴 Cita Cancelada</option>
                            </select>
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-outline-secondary btn-sm" title="Buscar">
                                <i class="bi bi-search"></i>
                            </button>
                            <a href="/Admin" class="btn btn-outline-danger btn-sm" title="Limpiar filtros">
                                <i class="bi bi-x-circle"></i>
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="tablaReservas">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4 py-3" style="width: 140px;">Fecha y Turno</th>
                            <th style="min-width: 160px;">Clienta</th>
                            <th style="min-width: 180px;">Servicio & Montos</th>
                            <th style="min-width: 280px;">Notas / Observaciones</th>
                            <th style="min-width: 210px;" class="pe-4">Estado de la Cita</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.ReservasTabla.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary opacity-50"></i>
                                    No se encontraron citas con los filtros seleccionados.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var r in Model.ReservasTabla)
                            {
                                var telLimpio = new string(r.Telefono?.Where(char.IsDigit).ToArray() ?? Array.Empty<char>());
                                var mensajeWa = System.Net.WebUtility.UrlEncode($"Hola {r.Nombre}, te saludamos de Talita Kumi Estudio de Belleza sobre tu cita de {r.Servicio} agendada para el {r.Fecha:dd/MM/yyyy} ({r.Horario}).");
                                var linkWa = $"https://wa.me/51{telLimpio}?text={mensajeWa}";

                                <tr data-reserva-id="@r.Id">
                                    <!-- FECHA Y TURNO -->
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">@r.Fecha.ToString("dd/MM/yyyy")</div>
                                        <div class="badge bg-light text-secondary border small mt-1">@r.Horario</div>
                                    </td>

                                    <!-- CLIENTA & CONTACTO -->
                                    <td>
                                        <div class="fw-bold text-dark">@r.Nombre</div>
                                        <div class="d-flex align-items-center gap-2 mt-1">
                                            <span class="text-muted small">@r.Telefono</span>
                                            <a href="@linkWa" target="_blank" class="badge bg-success text-white text-decoration-none px-2 py-1" title="Chatear en WhatsApp">
                                                <i class="bi bi-whatsapp"></i> Chat
                                            </a>
                                        </div>
                                    </td>

                                    <!-- SERVICIO Y PRECIO -->
                                    <td>
                                        <div class="fw-semibold text-dark text-truncate" style="max-width: 220px;" title="@r.Servicio">
                                            @r.Servicio
                                        </div>
                                        <div class="small text-muted mt-1 d-flex flex-wrap gap-2">
                                            <span>Precio: <strong>S/. @r.PrecioEstimado.ToString("0.00")</strong></span>
                                            <span class="celda-abono @(r.MontoAbonado > 0 ? "text-success fw-bold" : "text-muted")">
                                                Abono: S/. @r.MontoAbonado.ToString("0.00")
                                            </span>
                                        </div>
                                    </td>

                                    <!-- NOTAS EDITABLES IN SITU -->
                                    <td>
                                        <div class="input-group input-group-sm">
                                            <input type="text"
                                                   class="form-control input-nota"
                                                   placeholder="Escribe observaciones (alergias, tono, op Yape)..."
                                                   value="@r.Notas"
                                                   data-id="@r.Id" />
                                            <button class="btn btn-outline-secondary btn-guardar-nota"
                                                    type="button"
                                                    data-id="@r.Id"
                                                    title="Guardar notas">
                                                <i class="bi bi-floppy"></i> Guardar
                                            </button>
                                        </div>
                                        <div class="nota-feedback small text-success mt-1 d-none">
                                            <i class="bi bi-check-circle me-1"></i>Guardado
                                        </div>
                                    </td>

                                    <!-- SELECTOR DIRECTO DE ESTADO -->
                                    <td class="pe-4">
                                        <div class="d-flex align-items-center gap-2">
                                            <select class="form-select form-select-sm status-dropdown" data-id="@r.Id">
                                                <option value="Pendiente" selected="@(r.Estado == "Pendiente")">🟡 Pendiente de Abono</option>
                                                <option value="Confirmada" selected="@(r.Estado == "Confirmada")">🟢 Reserva Confirmada</option>
                                                <option value="Completada" selected="@(r.Estado == "Completada")">🔵 Servicio Finalizado</option>
                                                <option value="Cancelada" selected="@(r.Estado == "Cancelada")">🔴 Cita Cancelada</option>
                                            </select>
                                            <span class="status-spinner spinner-border spinner-border-sm text-primary d-none" role="status"></span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================
     MODAL 1: DETALLE DE CITA DEL CALENDARIO (PREVIEW POPUP)
     ======================================================== -->
<div class="modal fade" id="modalDetalleCita" tabindex="-1" aria-labelledby="modalDetalleCitaLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom py-3 px-4" style="background-color: var(--admin-bg);">
                <h5 class="modal-title fw-bold fs-6 text-dark" id="modalDetalleCitaLabel">
                    <i class="bi bi-calendar-event me-2 text-primary"></i> Detalle de Cita Agendada
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3 pb-3 border-bottom">
                    <div>
                        <h4 class="h5 fw-bold mb-1 text-dark" id="modalDetalleNombre">Nombre Clienta</h4>
                        <div class="text-muted small" id="modalDetalleTelefono">999 888 777</div>
                    </div>
                    <span class="badge px-3 py-2 fs-6 rounded-pill" id="modalDetalleBadgeEstado">Estado</span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label class="text-muted small fw-semibold text-uppercase">Fecha</label>
                        <div class="fw-bold text-dark" id="modalDetalleFecha">--/--/----</div>
                    </div>
                    <div class="col-6">
                        <label class="text-muted small fw-semibold text-uppercase">Turno</label>
                        <div class="fw-bold text-dark" id="modalDetalleHorario">Mañana</div>
                    </div>
                    <div class="col-6">
                        <label class="text-muted small fw-semibold text-uppercase">Servicio</label>
                        <div class="fw-bold text-dark" id="modalDetalleServicio">Manicura</div>
                    </div>
                    <div class="col-6">
                        <label class="text-muted small fw-semibold text-uppercase">Montos</label>
                        <div class="text-dark">
                            Estimado: <strong id="modalDetallePrecio">S/. 0.00</strong><br />
                            Abono: <strong class="text-success" id="modalDetalleAbono">S/. 0.00</strong>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="text-muted small fw-semibold text-uppercase">Notas y Observaciones</label>
                    <div class="p-3 bg-light rounded-3 text-secondary small border" id="modalDetalleNotas">
                        Sin observaciones registradas.
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <a href="#" id="modalDetalleBtnWa" target="_blank" class="btn btn-success d-flex align-items-center justify-content-center gap-2 py-2">
                        <i class="bi bi-whatsapp fs-5"></i> Contactar por WhatsApp
                    </a>
                </div>
            </div>
            <div class="modal-footer border-top py-2 px-4 bg-light">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================
     MODAL 2: ➕ AGENDAR CITA MANUALMENTE
     ======================================================== -->
<div class="modal fade" id="modalCrearReserva" tabindex="-1" aria-labelledby="modalCrearReservaLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <form asp-controller="Admin" asp-action="CrearReservaManual" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-bottom py-3 px-4" style="background-color: var(--admin-bg);">
                    <h5 class="modal-title fw-bold fs-6 text-dark" id="modalCrearReservaLabel">
                        <i class="bi bi-plus-circle-fill me-2 text-danger"></i> Agendar Cita Manualmente
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary">Nombre de la Clienta *</label>
                            <input type="text" name="Nombre" id="crearNombre" class="form-control" placeholder="Ej. Camila Torres" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary">Teléfono (WhatsApp) *</label>
                            <input type="tel" name="Telefono" id="crearTelefono" class="form-control" placeholder="Ej. 956123456" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary">Servicio del Catálogo</label>
                            <select name="ServicioId" id="crearServicioSelect" class="form-select">
                                <option value="">-- Seleccionar servicio predeterminado --</option>
                                @foreach (var s in Model.ServiciosDisponibles)
                                {
                                    <option value="@s.Id" data-precio="@s.PrecioBase" data-nombre="@s.Nombre">
                                        @s.Categoria • @s.Nombre (S/. @s.PrecioBase.ToString("0.00"))
                                    </option>
                                }
                            </select>
                            <div class="form-text small">O escribe el nombre específico abajo si es personalizado:</div>
                            <input type="text" name="ServicioNombrePersonalizado" id="crearServicioNombre" class="form-control form-control-sm mt-1" placeholder="Ej. Retiro de acrílico + Baño de leche" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label small fw-bold text-secondary">Precio Estimado (S/.) *</label>
                            <input type="number" step="0.50" min="0" name="Precio" id="crearPrecio" class="form-control" value="45.00" required />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label small fw-bold text-secondary">Monto Abonado (S/.)</label>
                            <input type="number" step="0.50" min="0" name="MontoAbonado" id="crearMontoAbonado" class="form-control" value="0.00" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-secondary">Fecha de Cita *</label>
                            <input type="date" name="Fecha" id="crearFecha" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-secondary">Turno / Horario *</label>
                            <select name="Horario" id="crearHorario" class="form-select" required>
                                <option value="Mañana (10:00 a 13:00)">Mañana (10:00 - 13:00)</option>
                                <option value="Tarde 1 (13:00 a 16:30)">Tarde 1 (13:00 - 16:30)</option>
                                <option value="Tarde 2 (16:30 a 19:30)">Tarde 2 (16:30 - 19:30)</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-secondary">Estado Inicial</label>
                            <select name="Estado" id="crearEstado" class="form-select">
                                <option value="Pendiente">🟡 Pendiente de Abono</option>
                                <option value="Confirmada">🟢 Reserva Confirmada (Abonó)</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label small fw-bold text-secondary">Notas / Observaciones</label>
                            <textarea name="Notas" id="crearNotas" rows="2" class="form-control" placeholder="Ej. Pago con Yape op. 39482. Quiere diseño almendrado."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top py-3 px-4 bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-koi">
                        <i class="bi bi-calendar-check me-1"></i> Agendar Cita
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

