@model TalitaKumiWebApp.ViewModels.Admin.LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión • Portal Administrador";
    Layout = null;
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Talita Kumi</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            background-color: var(--brand-bg, #FAF6F0);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--font-body);
            color: var(--color-charcoal);
            padding: 1rem;
        }
        .login-card {
            background: #FFFFFF;
            border: 1px solid var(--color-border, #E5DAD0);
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(67, 118, 148, 0.08);
            width: 100%;
            max-width: 420px;
            padding: 2.25rem;
        }
        .login-brand-icon {
            width: 54px;
            height: 54px;
            border-radius: 50%;
            background: var(--color-koi, #E85D3F);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            color: white;
            font-size: 1.5rem;
            margin: 0 auto 1rem;
            box-shadow: 0 4px 14px rgba(232, 93, 63, 0.3);
        }
        .login-title {
            font-family: var(--font-heading);
            font-size: 1.85rem;
            font-weight: 700;
            color: var(--color-charcoal);
            margin-bottom: 0.25rem;
        }
        .form-control:focus {
            border-color: var(--color-koi);
            box-shadow: 0 0 0 3px rgba(232, 93, 63, 0.15);
        }
        .btn-koi {
            background: var(--color-koi, #E85D3F);
            color: white;
            border: none;
            font-weight: 600;
            padding: 0.65rem 1.25rem;
            border-radius: 8px;
            transition: all 0.2s;
        }
        .btn-koi:hover {
            background: var(--color-koi-hover, #CF4B2F);
            color: white;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(232, 93, 63, 0.25);
        }
    </style>
</head>
<body>
    <div class="login-card text-center">
        <div class="login-brand-icon">TK</div>
        <h1 class="login-title">Talita Kumi</h1>
        <p class="text-muted small mb-4">Portal de Administración de Agenda</p>

        <form asp-action="Login" asp-controller="Admin" method="post" class="text-start">
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Username" class="form-label small fw-bold text-muted"></label>
                <input asp-for="Username" class="form-control" placeholder="Ej. naomi" autofocus />
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label small fw-bold text-muted"></label>
                <input asp-for="Password" class="form-control" placeholder="••••••••" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label small"></label>
            </div>

            <button type="submit" class="btn btn-koi w-100 mb-3">
                Iniciar Sesión
            </button>
        </form>

        <div class="text-center mt-3">
            <a href="/" class="text-muted small text-decoration-none">
                &larr; Volver al sitio web principal
            </a>
        </div>
    </div>
</body>
</html>
