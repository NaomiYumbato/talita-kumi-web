<!-- 1. HERO SECTION -->
<section class="hero-section" id="inicio">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6 order-2 order-lg-1">
                <span class="section-tag">
                    <i class="bi bi-stars me-1"></i> Estudio de Belleza Exclusivo
                </span>
                <h1 class="hero-title">
                    Uñas, cejas y pestañas hechas a tu medida
                </h1>
                <p class="hero-subtitle">
                    Tarapoto, Perú &#127477;&#127466;
                    <br />
                    Cuidado profesional, arte y detalle para realzar tu belleza natural.
                </p>
                <div class="d-flex flex-wrap gap-3 mb-4">
                    <a href="#reserva" class="btn btn-brand-primary btn-lg">
                        <i class="bi bi-calendar2-check me-2"></i>Reservar cita
                    </a>
                    <a href="#servicios" class="btn btn-outline-brand btn-lg">
                        Ver servicios
                    </a>
                </div>
            </div>

            <!-- FOTO GRANDE: Manos con manicura -->
            <div class="col-lg-6 order-1 order-lg-2">
                <div class="hero-img-wrapper text-center">
                    <img src="https://images.unsplash.com/photo-1632345031435-8727f6897d53?auto=format&fit=crop&w=1000&q=80" 
                         alt="Manos con manicura profesional y diseño exclusivo" 
                         class="hero-img img-fluid" />
                    
                    <div class="hero-floating-badge">
                        <div class="hero-badge-icon">
                            <i class="bi bi-gem"></i>
                        </div>
                        <div class="text-start">
                            <div class="fw-bold" style="font-size: 0.9rem;">Técnica Rusa & Soft Gel</div>
                            <small class="text-muted" style="font-size: 0.75rem;">Durabilidad de más de 21 días</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 2. SERVICIOS (4 tarjetas con foto, precio y tipos) -->
<section class="section-padding" id="servicios">
    <div class="container">
        <div class="text-center mb-5">
            <span class="section-tag">Nuestras Especialidades</span>
            <h2 class="section-title">Servicios que transforman tu día</h2>
            <p class="section-subtitle">
                Técnicas avanzadas y productos de primera línea para garantizar resultados duraderos e impecables.
            </p>
        </div>

        <div class="row g-4">
            <!-- Tarjeta 1: Manicura -->
            <div class="col-lg-3 col-md-6">
                <div class="service-card">
                    <div class="service-img-wrapper">
                        <img src="https://images.unsplash.com/photo-1604654894610-df63bc536371?auto=format&fit=crop&w=800&q=80" 
                             alt="Manicura Rusa y Semipermanente" class="service-img" />
                    </div>
                    <div class="service-body">
                        <h3 class="service-title">Manicura</h3>
                        <ul class="service-list">
                            <li><i class="bi bi-check2-circle"></i> Manicura Rusa combinada</li>
                            <li><i class="bi bi-check2-circle"></i> Esmaltado Semipermanente</li>
                            <li><i class="bi bi-check2-circle"></i> Kapping Gel / Acrigel</li>
                            <li><i class="bi bi-check2-circle"></i> Soft Gel Tips anatómicos</li>
                        </ul>
                        <a href="#reserva" class="btn btn-outline-brand w-100" onclick="preselectService('Manicura Semipermanente')">
                            Reservar Manicura
                        </a>
                    </div>
                </div>
            </div>

            <!-- Tarjeta 2: Pedicura -->
            <div class="col-lg-3 col-md-6">
                <div class="service-card">
                    <div class="service-img-wrapper">
                        <img src="https://images.unsplash.com/photo-1519415510236-718bdfcd89c8?auto=format&fit=crop&w=800&q=80" 
                             alt="Pedicura Spa y Belleza de Pies" class="service-img" />
                    </div>
                    <div class="service-body">
                        <h3 class="service-title">Pedicura</h3>
                        <ul class="service-list">
                            <li><i class="bi bi-check2-circle"></i> Pedicura Rusa profunda</li>
                            <li><i class="bi bi-check2-circle"></i> Spa de pies exfoliante</li>
                            <li><i class="bi bi-check2-circle"></i> Esmaltado Semipermanente</li>
                            <li><i class="bi bi-check2-circle"></i> Masaje relajante e hidratación</li>
                        </ul>
                        <a href="#reserva" class="btn btn-outline-brand w-100" onclick="preselectService('Pedicura Spa')">
                            Reservar Pedicura
                        </a>
                    </div>
                </div>
            </div>

            <!-- Tarjeta 3: Diseño -->
            <div class="col-lg-3 col-md-6">
                <div class="service-card">
                    <div class="service-img-wrapper">
                        <img src="https://images.unsplash.com/photo-1607779097040-26e80aa78e66?auto=format&fit=crop&w=800&q=80" 
                             alt="Diseño Nail Art y Esculpidas" class="service-img" />
                    </div>
                    <div class="service-body">
                        <h3 class="service-title">Diseño & Nail Art</h3>
                        <ul class="service-list">
                            <li><i class="bi bi-check2-circle"></i> Arte a mano alzada</li>
                            <li><i class="bi bi-check2-circle"></i> Efecto Cat Eye & Cromados</li>
                            <li><i class="bi bi-check2-circle"></i> French moderno y degradé</li>
                            <li><i class="bi bi-check2-circle"></i> Cristales y aplicaciones de foil</li>
                        </ul>
                        <div class="d-flex flex-column gap-2">
                            <button type="button" class="btn btn-brand-primary w-100" onclick="Chatbot.open()">
                                <i class="bi bi-chat-heart me-1"></i> Cotizar con Bot
                            </button>
                            <a href="#reserva" class="btn btn-outline-brand w-100" onclick="preselectService('Soft Gel Tips')">
                                Reservar Directo
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tarjeta 4: Cejas & Pestañas -->
            <div class="col-lg-3 col-md-6">
                <div class="service-card">
                    <div class="service-img-wrapper">
                        <img src="https://6ad017b9a148e8339071474e.imgix.net/eyelashes-and-eyebrows.png" 
                             alt="Lifting de Pestañas y Laminado de Cejas" class="service-img" />
                    </div>
                    <div class="service-body">
                        <h3 class="service-title">Cejas y Pestañas</h3>
                        <ul class="service-list">
                            <li><i class="bi bi-check2-circle"></i> Lifting + Tinte de pestañas</li>
                            <li><i class="bi bi-check2-circle"></i> Laminado & Nutrición de cejas</li>
                            <li><i class="bi bi-check2-circle"></i> Perfilado con visagismo facial</li>
                            <li><i class="bi bi-check2-circle"></i> Henna orgánica de alta definición</li>
                        </ul>
                        <a href="#reserva" class="btn btn-outline-brand w-100" onclick="preselectService('Lifting de Pestañas')">
                            Reservar Mirada
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 3. POR QUÉ ELEGIRNOS (3 íconos + 1 línea) -->
<section class="section-padding features-section">
    <div class="container">
        <div class="text-center mb-5">
            <span class="section-tag">Nuestro Compromiso</span>
            <h2 class="section-title">Por qué elegirnos</h2>
            <p class="section-subtitle">
                Cuidamos de ti con los más altos estándares de calidad, seguridad y bienestar.
            </p>
        </div>

        <div class="row g-4">
            <!-- 1. Higiene (Azul Olas) -->
            <div class="col-md-4">
                <div class="feature-box">
                    <div class="feature-icon-circle icon-water">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h4 class="feature-title">Higiene Absoluta</h4>
                    <p class="feature-desc">
                        Esterilización en autoclave médica de grado clínico y sobres descartables para cada clienta.
                    </p>
                </div>
            </div>

            <!-- 2. Materiales (Naranja Koi) -->
            <div class="col-md-4">
                <div class="feature-box">
                    <div class="feature-icon-circle icon-coral">
                        <i class="bi bi-droplet-half"></i>
                    </div>
                    <h4 class="feature-title">Materiales Premium</h4>
                    <p class="feature-desc">
                        Geles hipoalergénicos certificados, pigmentos cruelty-free y productos que preservan tu uña natural.
                    </p>
                </div>
            </div>

            <!-- 3. Atención (Dorado Koi) -->
            <div class="col-md-4">
                <div class="feature-box">
                    <div class="feature-icon-circle icon-gold">
                        <i class="bi bi-heart"></i>
                    </div>
                    <h4 class="feature-title">Atención Personalizada</h4>
                    <p class="feature-desc">
                        Sin apuros: dedicamos el tiempo necesario para escucharte, asesorarte y lograr el diseño que sueñas.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

