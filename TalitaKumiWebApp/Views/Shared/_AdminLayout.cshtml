<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Talita Kumi Portal Administrador</title>

    <!-- Google Fonts: Montserrat & Cormorant Garamond -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400;1,600&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/images/site-icon-koi.png" />

    <style>
        :root {
            --admin-bg: #FAF6F0;
            --admin-card: #FFFFFF;
            --admin-border: #E5DAD0;
            --admin-koi: #E85D3F;
            --admin-koi-hover: #CF4B2F;
            --admin-water: #437694;
            --admin-water-light: #EAF2F6;
        }

        body {
            background-color: var(--admin-bg);
            color: #2A313C;
            font-family: 'Montserrat', sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .admin-navbar {
            background-color: #FFFFFF;
            border-bottom: 1px solid var(--admin-border);
            box-shadow: 0 2px 10px rgba(67, 118, 148, 0.05);
            padding: 0.75rem 0;
        }

        .admin-brand-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--admin-koi), #F5A623);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 1.1rem;
            box-shadow: 0 3px 8px rgba(232, 93, 63, 0.25);
        }

        .admin-brand-title {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 700;
            font-size: 1.35rem;
            color: #161B22;
            letter-spacing: 0.05em;
            line-height: 1;
        }

        .admin-brand-badge {
            font-family: 'Montserrat', sans-serif;
            font-size: 0.68rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--admin-water);
            background: var(--admin-water-light);
            padding: 0.15rem 0.5rem;
            border-radius: 20px;
            display: inline-block;
            margin-top: 0.15rem;
        }

        .btn-koi {
            background-color: var(--admin-koi);
            color: #FFFFFF;
            border: none;
            font-weight: 600;
            font-size: 0.88rem;
            padding: 0.5rem 1.15rem;
            border-radius: 8px;
            transition: all 0.2s ease;
            box-shadow: 0 2px 6px rgba(232, 93, 63, 0.2);
        }

        .btn-koi:hover, .btn-koi:focus {
            background-color: var(--admin-koi-hover);
            color: #FFFFFF;
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(232, 93, 63, 0.3);
        }

        .user-greeting {
            background: #FFFFFF;
            border: 1px solid var(--admin-border);
            padding: 0.4rem 0.85rem;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 500;
            color: #2A313C;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
        }

        .admin-footer {
            margin-top: auto;
            background: #FFFFFF;
            border-top: 1px solid var(--admin-border);
            padding: 1rem 0;
            color: #627282;
            font-size: 0.82rem;
        }
    </style>
</head>
<body>
    @Html.AntiForgeryToken()

    <!-- NAVBAR CLARA -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg admin-navbar">
            <div class="container-fluid px-3 px-lg-4">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Admin" asp-action="Index">
                    <div class="admin-brand-icon">TK</div>
                    <div>
                        <div class="admin-brand-title">TALITA KUMI</div>
                        <div class="admin-brand-badge"><i class="bi bi-shield-check me-1"></i>Portal Administrador</div>
                    </div>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNavbarContent"
                        aria-controls="adminNavbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="adminNavbarContent">
                    <div class="ms-auto d-flex flex-wrap align-items-center gap-2 mt-2 mt-lg-0">
                        <span class="user-greeting">
                            <i class="bi bi-person-circle text-primary"></i>
                            <span>Hola, <strong id="adminNavbarNombre">@(User?.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User?.Identity?.Name ?? "Administrador")</strong></span>
                        </span>

                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#modalMiPerfil" title="Editar mis datos y contraseña">
                            <i class="bi bi-person-gear me-1"></i>Mi Perfil
                        </button>

                        <a href="/" target="_blank" class="btn btn-outline-secondary btn-sm" title="Abrir sitio web de clientas en nueva pestaña">
                            <i class="bi bi-box-arrow-up-right me-1"></i>Ver Sitio Web
                        </a>

                        <button type="button" class="btn btn-koi btn-sm" data-bs-toggle="modal" data-bs-target="#modalCrearReserva">
                            <i class="bi bi-plus-circle me-1"></i> Agendar Cita Manual
                        </button>

                        <form asp-controller="Admin" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Cerrar Sesión">
                                <i class="bi bi-box-arrow-right me-1"></i>Salir
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- CONTENIDO -->
    <main role="main" class="flex-grow-1 py-4">
        @RenderBody()
    </main>

    <!-- FOOTER CLARO -->
    <footer class="admin-footer text-center">
        <div class="container-fluid px-4">
            <span>&copy; @DateTime.Now.Year <strong>Talita Kumi Estudio de Belleza</strong> — Panel de Control Administrativo</span>
        </div>
    </footer>

    <!-- ========================================================
         MODAL GLOBAL: EDITAR PERFIL Y CONTRASEÑA
         ======================================================== -->
    <div class="modal fade" id="modalMiPerfil" tabindex="-1" aria-labelledby="modalMiPerfilLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <form id="formMiPerfil" onsubmit="handleGuardarPerfil(event)">
                    <div class="modal-header border-bottom py-3 px-4" style="background-color: var(--admin-bg);">
                        <h5 class="modal-title fw-bold fs-6 text-dark" id="modalMiPerfilLabel">
                            <i class="bi bi-person-gear text-primary me-2"></i> Mi Perfil de Administrador
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div id="perfilAlerta" class="alert alert-danger py-2 px-3 small d-none mb-3 d-flex align-items-center gap-2" role="alert">
                            <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                            <span id="perfilAlertaTexto"></span>
                        </div>

                        <div class="row g-3">
                            <!-- Usuario de Acceso -->
                            <div class="col-12">
                                <label for="perfilUsername" class="form-label small fw-bold text-secondary">Usuario de Acceso *</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-shield-lock text-muted"></i></span>
                                    <input type="text" id="perfilUsername" class="form-control border-start-0" placeholder="Tu usuario de acceso" required autocomplete="username" />
                                </div>
                                <div class="form-text small" style="font-size: 0.75rem;">Usuario que utilizarás para iniciar sesión en el portal.</div>
                            </div>

                            <!-- Nombre Completo -->
                            <div class="col-12">
                                <label for="perfilNombreCompleto" class="form-label small fw-bold text-secondary">Nombre Completo *</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-person text-muted"></i></span>
                                    <input type="text" id="perfilNombreCompleto" class="form-control border-start-0" placeholder="Tu nombre completo" required />
                                </div>
                            </div>

                            <!-- Separador Seguridad -->
                            <div class="col-12 pt-2">
                                <div class="border-top pt-3">
                                    <div class="fw-bold small text-dark d-flex align-items-center gap-1 mb-1">
                                        <i class="bi bi-key-fill text-warning"></i> Cambiar Contraseña (Opcional)
                                    </div>
                                    <p class="text-muted small mb-2" style="font-size: 0.78rem;">
                                        Deja estos campos en blanco si solo deseas actualizar tu nombre.
                                    </p>
                                </div>
                            </div>

                            <!-- Contraseña Actual -->
                            <div class="col-12">
                                <label for="perfilPasswordActual" class="form-label small fw-bold text-secondary">Contraseña Actual</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-lock text-muted"></i></span>
                                    <input type="password" id="perfilPasswordActual" class="form-control border-start-0 border-end-0" placeholder="Tu contraseña actual" autocomplete="current-password" />
                                    <button class="btn btn-outline-secondary border-start-0 btn-toggle-password" type="button" data-target="perfilPasswordActual" title="Mostrar/Ocultar">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Nueva Contraseña -->
                            <div class="col-12">
                                <label for="perfilNuevoPassword" class="form-label small fw-bold text-secondary">Nueva Contraseña</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-shield-plus text-muted"></i></span>
                                    <input type="password" id="perfilNuevoPassword" class="form-control border-start-0 border-end-0" placeholder="Mínimo 6 caracteres" autocomplete="new-password" />
                                    <button class="btn btn-outline-secondary border-start-0 btn-toggle-password" type="button" data-target="perfilNuevoPassword" title="Mostrar/Ocultar">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Confirmar Nueva Contraseña -->
                            <div class="col-12">
                                <label for="perfilConfirmarPassword" class="form-label small fw-bold text-secondary">Confirmar Nueva Contraseña</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-check2-circle text-muted"></i></span>
                                    <input type="password" id="perfilConfirmarPassword" class="form-control border-start-0 border-end-0" placeholder="Repite la nueva contraseña" autocomplete="new-password" />
                                    <button class="btn btn-outline-secondary border-start-0 btn-toggle-password" type="button" data-target="perfilConfirmarPassword" title="Mostrar/Ocultar">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-top py-3 px-4 bg-light">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" id="btnGuardarPerfil" class="btn btn-koi">
                            <i class="bi bi-check2-circle me-1"></i> Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin-dashboard.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
